{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Next.js app (games and hub); the app adds its own \"paths\"",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "es2017",
    "lib": ["dom", "esnext"],
    "allowJs": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "${configDir}/next-env.d.ts",
    "${configDir}/**/*.ts",
    "${configDir}/**/*.tsx",
    "${configDir}/**/*.mts",
    "${configDir}/.next/types/**/*.ts",
    "${configDir}/.next/dev/types/**/*.ts"
  ],
  "exclude": ["${configDir}/node_modules"]
}
