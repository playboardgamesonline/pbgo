  },
  "peerDependencies": {
    "next": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@pbgo/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
