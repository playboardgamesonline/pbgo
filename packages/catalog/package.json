{
  "name": "@pbgo/catalog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The hub catalog: the live games of the registry and the planned games of the Notion Games database, joined into one list. `.` is the pure model, `./server` the cached reader for apps/web, `./route` the handler of the pictures of the planned games.",
  "exports": {
    ".": "./src/catalog.ts",
    "./filter": "./src/filter.ts",
    "./server": "./src/server.ts",
    "./route": "./src/route.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pbgo/core": "workspace:*",
    "@pbgo/games": "workspace:*",
    "@pbgo/studio-kit": "workspace:*",
    "server-only": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@pbgo/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
