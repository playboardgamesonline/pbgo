    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@pbgo/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "catalog:",
    "react": "catalog:",
