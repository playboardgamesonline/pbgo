# Environment of apps/web, the single app of playboardgamesonline.app (hub + every game).
# Copy to .env.local for local development; on Vercel, set them on the project "pbgo".
# `pnpm setup-env` fills both from ~/.config/pbgo/secrets.env (locally the Supabase keys are the preview project's)
# and applies the pending supabase/migrations to the Supabase projects.

# Public URL of the site (canonical URLs, sitemap, share images). Default: https://playboardgamesonline.app
# NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Supabase: one project for every game (tables carry a `game` column, see supabase/migrations)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Gamemaster (/gamemaster): one account and one signed session for every game.
# Closed whenever one of the three is missing, except in local development (`next dev`) with none of them set.
ADMIN_LOGIN=
ADMIN_PASSWORD=
# Signs the session cookie, at least 32 characters (`openssl rand -base64 48`). Changing it, ADMIN_LOGIN or ADMIN_PASSWORD signs everyone out.
# `pnpm setup-env` generates one when there is none and appends it to ~/.config/pbgo/secrets.env, never overwriting a value there.
ADMIN_SESSION_SECRET=

# The nightly clean-up of old tables and feedback (GET /api/cron/purge): Vercel Cron sends this as `Authorization: Bearer …`.
# At least 32 characters (`openssl rand -base64 48`); without a valid one the route answers 401, in development too.
# `pnpm setup-env` generates one, appends it to ~/.config/pbgo/secrets.env and pushes it to Vercel. Locally it is the token that
# purges the preview project from a dev server (docs/supabase-and-env.md).
CRON_SECRET=

# Sign-in with Steam (docs/accounts.md): the key of Steam's Web API, which gives the name and the picture of a player. It is the switch: /login and /signup offer Steam only when it is set
# (with the Supabase project and its secret key, above). Get one at https://steamcommunity.com/dev/apikey for the domain playboardgamesonline.app; set it on Vercel for Production and Preview. Migration 0010 first (`pnpm setup-env`).
STEAM_WEB_API_KEY=

# Vercel API, optional (Gamemaster › Audience and Health). Both or neither: `pnpm setup-env` requires VERCEL_TEAM_ID as soon as
# there is a VERCEL_TOKEN (no default team, no Vercel CLI login), and touches Vercel only with a token.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# VERCEL_ANALYTICS_PROJECT_ID=   # defaults to VERCEL_PROJECT_ID on Vercel

# PostHog analytics, optional. Both or neither: without them the analytics and the cookie banner are off.
# The key is public (it ships to the browser); the host is the ingest host of the project (https://eu.i.posthog.com), no trailing slash.
# Inlined at build time, so a change applies from the next build. `pnpm setup-env` reads both from ~/.config/pbgo/secrets.env,
# checks their shape and pushes them to every Vercel target; events carry `env` (production, preview or development) to tell them apart.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# The hub's catalog (packages/catalog) is read from the platform's own Sanity project, whose dataset is public: nothing to set.
# `pnpm catalog:list` shows what the hub would list. NOTION_API_KEY is only for the platform's seed (platform/content), in this file.
# NOTION_API_KEY=

# Sanity: each game has its own project (projectId in packages/games/src/registry.ts), dataset "production".
# NEXT_PUBLIC_SANITY_DATASET=production
# Write token of each game's project (admin saves), named SANITY_API_WRITE_TOKEN_<SLUG>, "-" → "_".
# Without it, that game's admin is read-only. `pnpm setup-env` reuses the token it finds (secrets file, this file, then the
# Vercel project) and creates one only when none exists.
SANITY_API_WRITE_TOKEN_COURTISANS=
SANITY_API_WRITE_TOKEN_TEMPLATE=
SANITY_API_WRITE_TOKEN_6_NIMMT=
SANITY_API_WRITE_TOKEN_7_WONDERS=
SANITY_API_WRITE_TOKEN_CRY_BABY=
SANITY_API_WRITE_TOKEN_DRACULA_VS_VAN_HELSING=
SANITY_API_WRITE_TOKEN_EXPLODING_KITTENS=
SANITY_API_WRITE_TOKEN_FLIP_7=
SANITY_API_WRITE_TOKEN_HANABI=
SANITY_API_WRITE_TOKEN_LOVE_LETTER=
SANITY_API_WRITE_TOKEN_ODIN=
SANITY_API_WRITE_TOKEN_OMENS=
SANITY_API_WRITE_TOKEN_SKULL_KING=
SANITY_API_WRITE_TOKEN_SKY_TEAM=
SANITY_API_WRITE_TOKEN_SKYJO=
SANITY_API_WRITE_TOKEN_TIME_BOMB=
SANITY_API_WRITE_TOKEN_TRIO=
SANITY_API_WRITE_TOKEN_WELCOME_TO=

# Debug routes in production (/api/<slug>/games/<code>/debug): "1" to allow them
# DEBUG_GAMES=1

# Seconds the players have to be ready (their boards loaded) once a table is started (the ready check), 5 to 600. Default 60; a short one is how the deadline is tried by hand.
# READY_CHECK_SECONDS=60
