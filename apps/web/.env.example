# Environment of apps/web, the single app of playboardgamesonline.app (hub + every game).
# Copy to .env.local for local development; on Vercel, set them on the project "playboardgamesonline".
# `pnpm setup-env` fills both from ~/.config/pbgo/secrets.env (locally the Supabase keys are the preview project's).

# Public URL of the site (canonical URLs, sitemap, share images). Default: https://playboardgamesonline.app
# NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Supabase: one project for every game (tables carry a `game` column, see supabase/migrations)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Admin (/<slug>/admin): one account for every game
ADMIN_LOGIN=
ADMIN_PASSWORD=

# Vercel API, optional (admin › Audience and Health)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# VERCEL_ANALYTICS_PROJECT_ID=   # defaults to VERCEL_PROJECT_ID on Vercel

# Sanity: each game has its own project (projectId in packages/games/src/registry.ts), dataset "production".
# NEXT_PUBLIC_SANITY_DATASET=production
# Write token of each game's project (admin saves), named SANITY_API_WRITE_TOKEN_<SLUG>, "-" → "_".
# Without it, that game's admin is read-only.
SANITY_API_WRITE_TOKEN_COURTISANS=
SANITY_API_WRITE_TOKEN_TEMPLATE=
SANITY_API_WRITE_TOKEN_6_NIMMT=
SANITY_API_WRITE_TOKEN_7_WONDERS=
SANITY_API_WRITE_TOKEN_CRY_BABY=
SANITY_API_WRITE_TOKEN_DRACULA_VS_VAN_HELSING=
SANITY_API_WRITE_TOKEN_EXPLODING_KITTENS=
SANITY_API_WRITE_TOKEN_FLIP_7=
SANITY_API_WRITE_TOKEN_HANABI=
SANITY_API_WRITE_TOKEN_LOVE_LETTER=
SANITY_API_WRITE_TOKEN_ODIN=
SANITY_API_WRITE_TOKEN_OMENS=
SANITY_API_WRITE_TOKEN_SKULL_KING=
SANITY_API_WRITE_TOKEN_SKY_TEAM=
SANITY_API_WRITE_TOKEN_SKYJO=
SANITY_API_WRITE_TOKEN_TIMEBOMB=
SANITY_API_WRITE_TOKEN_TRIO=
SANITY_API_WRITE_TOKEN_WELCOME_TO=

# Debug routes in production (/api/<slug>/games/<code>/debug): "1" to allow them
# DEBUG_GAMES=1
