{
  "name": "play-board-games-online",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "bash scripts/run.sh dev",
    "dev:studio": "bash scripts/run.sh dev:studio",
    "build": "pnpm --filter web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "check:catalog": "node scripts/check-catalog.mjs",
    "check:public": "node scripts/check-public.mjs",
    "catalog:list": "node --disable-warning=ExperimentalWarning packages/catalog/scripts/list.ts",
    "new-game": "bash scripts/new-game.sh",
    "go-live": "bash scripts/go-live.sh",
    "add-game": "bash scripts/add-game.sh",
    "game-rules": "bash scripts/game-rules.sh",
    "setup-env": "bash scripts/setup-env.sh"
  }
}
