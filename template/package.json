{
  "name": "template",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter template-web dev",
    "dev:studio": "pnpm --filter template-studio dev",
    "build": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" build",
    "test": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" test",
    "typecheck": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" typecheck",
    "deploy:studio": "pnpm --filter template-studio run deploy",
    "setup:env": "bash scripts/setup-env.sh",
    "go-live": "bash scripts/go-live.sh"
  }
}
