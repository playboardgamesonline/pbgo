{
  "name": "@pbgo-game/exploding-kittens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Exploding Kittens for apps/web: site constants, logo and default look. No engine yet, so its home page says \"coming soon\".",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui.tsx",
    "./server": "./src/server.ts",
    "./runtime": "./src/runtime.tsx",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p content && tsc --noEmit -p content/parity",
    "test": "vitest run",
    "content:seed": "node --disable-warning=ExperimentalWarning content/seed.ts",
    "dev:studio": "pnpm --filter exploding-kittens-studio dev",
    "deploy:studio": "pnpm --filter exploding-kittens-studio run deploy"
  },
  "dependencies": {
    "@pbgo/core": "workspace:*",
    "@pbgo/ui": "workspace:*",
    "server-only": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@exploding-kittens/engine": "workspace:*",
    "@pbgo/content-kit": "workspace:*",
    "@pbgo/studio-kit": "workspace:*",
    "@pbgo/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
