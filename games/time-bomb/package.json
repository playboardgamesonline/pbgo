{
  "name": "@pbgo-game/time-bomb",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Timebomb for apps/web: site constants, logo and default look. No engine yet, so its home page says \"coming soon\".",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui.tsx",
    "./server": "./src/server.ts",
    "./runtime": "./src/runtime.tsx",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev:studio": "pnpm --filter time-bomb-studio dev",
