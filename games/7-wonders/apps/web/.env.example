NEXT_PUBLIC_SANITY_PROJECT_ID=__SANITY_PROJECT_ID__
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase (vercel env pull .env.local when the Vercel ↔ Supabase integration is connected)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Schéma Postgres du jeu dans le projet Supabase partagé (vide = public)
NEXT_PUBLIC_SUPABASE_SCHEMA=
# Admin account for /setup and /status (required in production)
ADMIN_LOGIN=
ADMIN_PASSWORD=
# Sanity token with Editor rights: lets /setup save settings and upload the logo
SANITY_API_WRITE_TOKEN=
# Vercel Web Analytics on /status (Account Settings → Tokens). Optional:
# VERCEL_TEAM_ID for team projects, VERCEL_ANALYTICS_PROJECT_ID if VERCEL_PROJECT_ID is not exposed
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_ANALYTICS_PROJECT_ID=
# Enable game debug commands in production (1)
DEBUG_GAMES=
