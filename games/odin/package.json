{
  "name": "odin",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter odin-web dev",
    "dev:studio": "pnpm --filter odin-studio dev",
    "build": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" build",
    "test": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" test",
    "typecheck": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" typecheck",
    "deploy:studio": "pnpm --filter odin-studio run deploy"
  }
}
