{
  "name": "@pbgo-game/love-letter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Love Letter for apps/web: site constants, logo, default look and the engine (GAME). No board yet: outside production a table can be opened but one that starts has nothing to show, and in production its page says \"coming soon\".",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui.tsx",
    "./server": "./src/server.ts",
    "./runtime": "./src/runtime.tsx",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p content && tsc --noEmit -p content/parity",
    "test": "vitest run",
    "content:seed": "node --disable-warning=ExperimentalWarning content/seed.ts",
    "dev:studio": "pnpm --filter love-letter-studio dev",
    "deploy:studio": "pnpm --filter love-letter-studio run deploy"
  },
  "dependencies": {
    "@love-letter/engine": "workspace:*",
    "@pbgo/core": "workspace:*",
    "@pbgo/ui": "workspace:*",
    "server-only": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@pbgo/content-kit": "workspace:*",
    "@pbgo/engine-kit": "workspace:*",
    "@pbgo/studio-kit": "workspace:*",
    "@pbgo/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
