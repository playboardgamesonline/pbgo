{
  "name": "@pbgo-game/flip-7",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Flip 7 for apps/web: site constants, logo, default look and the engine (GAME). No board yet: outside production a table can be opened but one that starts has nothing to show, and in production its page says \"coming soon\".",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui.tsx",
    "./server": "./src/server.ts",
    "./runtime": "./src/runtime.tsx",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p content && tsc --noEmit -p content/parity",
    "test": "vitest run",
    "content:seed": "node --disable-warning=ExperimentalWarning content/seed.ts",
    "dev:studio": "pnpm --filter flip-7-studio dev",
    "deploy:studio": "pnpm --filter flip-7-studio run deploy"
  },
  "dependencies": {
    "@flip-7/engine": "workspace:*",
    "@pbgo/core": "workspace:*",
    "@pbgo/table": "workspace:*",
    "@pbgo/ui": "workspace:*",
    "@react-three/drei": "catalog:",
    "@react-three/fiber": "catalog:",
    "@sanity/client": "catalog:",
    "next-sanity": "catalog:",
    "server-only": "catalog:",
    "sonner": "catalog:",
    "three": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@pbgo/content-kit": "workspace:*",
    "@pbgo/engine-kit": "workspace:*",
    "@pbgo/studio-kit": "workspace:*",
    "@pbgo/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
