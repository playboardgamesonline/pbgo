{
  "name": "flip-7",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter flip-7-web dev",
    "dev:studio": "pnpm --filter flip-7-studio dev",
    "build": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" build",
    "test": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" test",
    "typecheck": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" typecheck",
    "deploy:studio": "pnpm --filter flip-7-studio run deploy"
  }
}
