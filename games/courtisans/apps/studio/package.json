{
  "name": "courtisans-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "typecheck": "tsc --noEmit",
    "typegen": "sanity schemas extract --force && sanity typegen generate",
    "schema:deploy": "sanity schemas deploy",
    "update-images": "sanity exec scripts/update-images.ts --with-user-token",
    "undo-import": "sanity exec scripts/undo-import.ts --with-user-token --",
    "clean-png": "sanity exec scripts/clean-png.ts --with-user-token --",
    "migrate:core": "sanity exec scripts/migrate-to-core.ts --with-user-token --"
  },
  "dependencies": {
    "@pbgo/studio-kit": "workspace:*",
    "@sanity/icons": "catalog:",
    "@sanity/vision": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sanity": "catalog:",
    "styled-components": "catalog:"
  },
  "devDependencies": {
    "@pbgo/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:"
  }
}
